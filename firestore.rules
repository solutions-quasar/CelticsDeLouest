rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if the user is a master admin (hardcoded for safety)
    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.token.email == "bensult78@gmail.com" || 
        request.auth.token.email == "admin@celtics.com" || 
        request.auth.token.email == "celtics.portneuf@gmail.com"
      );
    }

    // Helper: Check permissions for a specific module and level
    function hasPermission(module, level) {
      return isMasterAdmin() || (
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) && (
          get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role.hasAny(["SuperAdmin", module + ":" + level]) ||
          (level == "view" && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role.hasAny([module + ":edit"])) ||
          (level == "edit" && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role.hasAny([module]))
        )
      );
    }
    
    function canView(module) {
      return request.auth != null && hasPermission(module, "view");
    }

    function canEdit(module) {
      return request.auth != null && hasPermission(module, "edit");
    }

    // PRODUCTS (Boutique)
    match /products/{productId} {
      allow read: if true;
      allow write: if canEdit("Boutique");
    }

    // BOARD MEMBERS (Conseil d'administration)
    match /board_members/{memberId} {
      allow read: if true;
      allow write: if canEdit("Club");
    }

    // REFEREES (Arbitres)
    match /referees/{refereeId} {
      allow read: if true;
      allow write: if canEdit("Club");
    }

    // REGISTRATIONS (Inscriptions)
    match /registrations/{regId} {
      allow create: if true;
      allow read: if canView("Inscriptions");
      allow update, delete: if canEdit("Inscriptions");
    }

    // PLAYERS (Team Generator)
    match /players/{playerId} {
      allow read: if canView("Equipes");
      allow write: if canEdit("Equipes");
    }

    // INVENTORY
    match /inventory/{itemId} {
      allow read: if canView("Boutique");
      allow write: if canEdit("Boutique");
    }

    // ADMINS
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isMasterAdmin() || (
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role.hasAny(["SuperAdmin"])
      );
    }

    // COACHES
    match /coaches/{coachId} {
      allow read: if true;
      allow write: if canEdit("Equipes");
    }
    
    // SETTINGS (Global Config)
    match /settings/{docId} {
      allow read: if true;
      allow write: if canEdit("Config");
    }
    
    // MATCHES
    match /matches/{matchId} {
        allow read: if true;
        allow write: if canEdit("Matchs");
    }

    // SPONSORS
    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if canEdit("Club");
    }

    // TEAMS
    match /teams/{teamId} {
      allow read: if canView("Equipes");
      allow write: if canEdit("Equipes");
    }

    // SEASONS
    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if canEdit("Config");
    }

    // FIELDS (Terrains)
    match /fields/{fieldId} {
      allow read: if true;
      allow write: if canEdit("Config");
    }

    // EMAIL CAMPAIGNS
    match /campaigns/{campaignId} {
        allow read: if canView("Campagnes");
        allow write: if canEdit("Campagnes");
    }

    // INVOICES (Stripe Integration)
    match /invoices/{invoiceId} {
        allow read: if canView("Facturation");
        allow write: if canEdit("Facturation");
    }

    // SCHEDULED PAYMENTS (Installments)
    match /scheduled_payments/{paymentId} {
        allow read: if canView("Facturation");
        allow write: if canEdit("Facturation");
    }
    
    // Default fallback: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}