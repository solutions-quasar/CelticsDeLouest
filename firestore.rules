rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check permissions for a specific module and level
    function hasPermission(module, level) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) && (
          "SuperAdmin" in get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role ||
          (module + ":" + level) in get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role ||
          (level == "view" && (module + ":edit") in get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role) ||
          (level == "edit" && module in get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role)
        );
    }
    
    function canView(module) {
      return request.auth != null && hasPermission(module, "view");
    }

    function canEdit(module) {
      return request.auth != null && hasPermission(module, "edit");
    }

    // PRODUCTS (Boutique)
    match /products/{productId} {
      allow read: if true;
      allow write: if canEdit("Boutique");
    }

    // BOARD MEMBERS (Conseil d'administration)
    match /board_members/{memberId} {
      allow read: if true;
      allow write: if canEdit("Club");
    }

    // REFEREES (Arbitres)
    match /referees/{refereeId} {
      allow read: if true;
      allow write: if canEdit("Club");
    }

    // REGISTRATIONS (Inscriptions)
    match /registrations/{regId} {
      allow create: if true;
      allow read: if canView("Inscriptions");
      allow update, delete: if canEdit("Inscriptions");
    }

    // PLAYERS (Team Generator)
    match /players/{playerId} {
      allow read: if canView("Equipes");
      allow write: if canEdit("Equipes");
    }

    // INVENTORY
    match /inventory/{itemId} {
      allow read: if canView("Boutique");
      allow write: if canEdit("Boutique");
    }

    // ADMINS
    match /admins/{adminId} {
      allow read: if request.auth != null;
      // Allow writing if the user is a SuperAdmin OR if they are updating their own record (migration/self-info)
      allow write: if request.auth != null && (
        (request.auth.token.email.lower() == adminId) || 
        (exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
         "SuperAdmin" in get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role)
      );
    }

    // COACHES
    match /coaches/{coachId} {
      allow read: if true;
      allow write: if canEdit("Equipes");
    }
    
    // SETTINGS (Global Config)
    match /settings/{docId} {
      allow read: if true;
      allow write: if canEdit("Config");
    }
    
    // MATCHES
    match /matches/{matchId} {
      allow read: if true;
      allow create, delete: if canEdit("Matchs");
      allow update: if canEdit("Matchs") || (
        request.auth != null && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableRefs'])
      );
    }

    // SPONSORS
    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if canEdit("Club");
    }

    // TEAMS
    match /teams/{teamId} {
      allow read: if canView("Equipes");
      allow write: if canEdit("Equipes");
    }

    // SEASONS
    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if canEdit("Config");
    }

    // FIELDS (Terrains)
    match /fields/{fieldId} {
      allow read: if true;
      allow write: if canEdit("Config");
    }

    // EMAIL CAMPAIGNS
    match /campaigns/{campaignId} {
        allow read: if canView("Campagnes");
        allow write: if canEdit("Campagnes");
    }

    // INVOICES (Stripe Integration)
    match /invoices/{invoiceId} {
        allow read: if canView("Facturation");
        allow write: if canEdit("Facturation");
    }

    // SCHEDULED PAYMENTS (Installments)
    match /scheduled_payments/{paymentId} {
        allow read: if canView("Facturation");
        allow write: if canEdit("Facturation");
    }

    // AUTOMATION DOCUMENTATION
    match /automation_notes/{noteId} {
        // Technically Automations module permission not defined yet, using generic admin check or Config
        // Let's assume Automations falls under Config or a new "Automations" key.
        // For now, allow all authenticated admins (or reuse Config permission)
        allow read: if request.auth != null; // Visible to all admins
        allow write: if canEdit("Config") || canEdit("Automations");
    }
    
    // Default fallback: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}